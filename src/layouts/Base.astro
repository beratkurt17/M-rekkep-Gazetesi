---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  publishedAt?: string;
  compactHeader?: boolean;
}

const SITE_NAME = 'Mürekkep Gazetesi';
const DEFAULT_DESC = 'Mürekkep; edebiyat, kültür ve sanat gazetesi.';

const {
  title,
  description = DEFAULT_DESC,
  image,
  type = 'website',
  publishedAt,
  compactHeader = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — Edebiyat, Kültür, Sanat`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/logo.jpg', Astro.site);
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#faf8f4" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />

  <!-- Paylaşım önizlemeleri (Instagram, WhatsApp, X) -->
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE_NAME} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {publishedAt && <meta property="article:published_time" content={publishedAt} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap"
  />
</head>
<body>
  <Masthead compact={compactHeader} />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

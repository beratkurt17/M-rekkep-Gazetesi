---
import '../styles/global.css';
import '../styles/feed.css';
import '../styles/article.css';
import '../styles/baski.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { FONT_URL } from '../lib/fonts';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  /** Görselin boyutu biliniyorsa (ör. paylaşım kartı 1200×630) önizleme daha hızlı oluşur. */
  imageSize?: { width: number; height: number };
  type?: 'website' | 'article';
  publishedAt?: string;
  compactHeader?: boolean;
}

const SITE_NAME = 'Mürekkep';
const DEFAULT_DESC = 'Mürekkep — edebiyat gazetesi. Şiir, öykü, deneme ve söyleşiler.';

const {
  title,
  description = DEFAULT_DESC,
  image,
  imageAlt,
  imageSize,
  type = 'website',
  publishedAt,
  compactHeader = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — Edebiyat gazetesi`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/logo.jpg', Astro.site);
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#e8e0d0" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  <link rel="alternate" type="application/rss+xml" title="Mürekkep" href="/rss.xml" />

  <!-- Bağlantı önizlemesi (WhatsApp, Instagram, X) -->
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? SITE_NAME} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt ?? title ?? SITE_NAME} />
  {imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
  {imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}
  {publishedAt && <meta property="article:published_time" content={publishedAt} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={FONT_URL} />
</head>
<body>
  <Masthead compact={compactHeader} />
  <main>
    <slot />
  </main>
  <Footer />
  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>

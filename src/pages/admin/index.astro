---
import '../../styles/global.css';
import '../../styles/feed.css';
import '../../styles/article.css';
import '../../styles/admin.css';
import Giris from '../../components/admin/Giris.astro';
import UstMenu from '../../components/admin/UstMenu.astro';
import YaziListesi from '../../components/admin/YaziListesi.astro';
import YaziDuzenle from '../../components/admin/YaziDuzenle.astro';
import Sayilar from '../../components/admin/Sayilar.astro';
import Yazarlar from '../../components/admin/Yazarlar.astro';
import Diziler from '../../components/admin/Diziler.astro';
import Koseler from '../../components/admin/Koseler.astro';
import Onizleme from '../../components/admin/Onizleme.astro';
import { FONT_URL } from '../../lib/fonts';
const configured = !!(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#e8e0d0" />
  <title>Yönetim | Mürekkep</title>
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  <link rel="stylesheet" href={FONT_URL} />
</head>
<body class="admin">
  {!configured && (
    <div class="center-box">
      <h1>Supabase bağlı değil</h1>
      <p>Proje kökündeki <code>.env</code> dosyasına <code>PUBLIC_SUPABASE_URL</code> ve
        <code>PUBLIC_SUPABASE_ANON_KEY</code> değerlerini gir, sonra <code>npm run dev</code>'i yeniden başlat.</p>
    </div>
  )}

  <Giris />

  <!-- PANEL: her ekran kendi bileşeninde (src/components/admin/) -->
  <div id="app" hidden>
    <UstMenu />
    <YaziListesi />
    <YaziDuzenle />
    <Sayilar />
    <Yazarlar />
    <Diziler />
    <Koseler />
  </div>

  <Onizleme />
  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

  <script>
    import { initAdmin } from '../../admin/app';
    initAdmin();
  </script>
</body>
</html>

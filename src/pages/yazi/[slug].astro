---
import Base from '../../layouts/Base.astro';
import ShareSheet from '../../components/ShareSheet.astro';
import { getArticles, usingSampleData } from '../../lib/db';
import { plainExcerpt } from '../../lib/format';
import { articleHtml, feedItemHtml, articlePath, whatsappUrl } from '../../lib/render';
import type { Article } from '../../lib/types';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((article, i) => ({
    params: { slug: article.slug },
    props: {
      article,
      next: all[i + 1] ?? null, // bir önceki (daha eski) yazı
      more: all.filter((a) => a.id !== article.id && a.id !== all[i + 1]?.id).slice(0, 3),
    },
  }));
}

interface Props { article: Article; next: Article | null; more: Article[] }
const { article: a, next, more } = Astro.props;

const url = new URL(articlePath(a.slug), Astro.site).toString();
const domain = Astro.site!.host;
const description = a.spot || plainExcerpt(a.body);

const supabaseUrl = usingSampleData ? '' : import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = usingSampleData ? '' : import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<Base
  title={a.title}
  description={description}
  image={a.cover_image}
  imageAlt={a.image_caption ?? a.title}
  type="article"
  publishedAt={a.published_at}
  compactHeader
>
  <div class="wrap">
    <article
      class="art"
      data-article
      data-url={url}
      data-title={a.title}
      data-byline={a.byline ?? ''}
      data-quote={a.ig_quote ?? ''}
      data-domain={domain}
      data-slug={a.slug}
    >
      <Fragment set:html={articleHtml(a)} />

      <section class="art-share reading-hide" aria-labelledby="paylas">
        <h2 class="section-title" id="paylas">Bu yazıyı paylaş</h2>
        <div class="share-row">
          <a class="share-opt" href={whatsappUrl(a.title, url)} target="_blank" rel="noopener">WhatsApp’ta paylaş</a>
          <button type="button" class="share-opt" data-share="story">Instagram hikâye kartı</button>
          <button type="button" class="share-opt" data-share="copy">Bağlantıyı kopyala</button>
        </div>
      </section>
    </article>

    {(next || more.length > 0) && (
      <aside class="art suggestions reading-hide" aria-label="Öneriler">
        {next && (
          <section>
            <h2 class="section-title">Sıradaki yazı</h2>
            <div class="feed" set:html={feedItemHtml(next)} />
          </section>
        )}
        {more.length > 0 && (
          <section>
            <h2 class="section-title">Diğer yazılar</h2>
            <div class="feed" set:html={more.map((m) => feedItemHtml(m)).join('')} />
          </section>
        )}
      </aside>
    )}
  </div>

  <div id="reading-bar" class="reading-bar" role="toolbar" aria-label="Okuma ayarları" hidden>
    <button type="button" data-font="-" aria-label="Yazıyı küçült">A−</button>
    <button type="button" data-font="+" aria-label="Yazıyı büyüt">A+</button>
    <button type="button" class="rb-exit">Okuma modundan çık</button>
  </div>

  <ShareSheet whatsappHref={whatsappUrl(a.title, url)} />

  <script>
    import { initReadingMode } from '../../scripts/reading-mode';
    import { initShare } from '../../scripts/share';
    initReadingMode();
    initShare();
  </script>

  {supabaseUrl && (
    <script is:inline define:vars={{ supabaseUrl, supabaseKey, slug: a.slug }}>
      // Okunma sayacı: aynı tarayıcıda aynı yazı oturum başına bir kez sayılır.
      try {
        const k = 'okundu:' + slug;
        if (!sessionStorage.getItem(k)) {
          sessionStorage.setItem(k, '1');
          fetch(supabaseUrl + '/rest/v1/rpc/increment_view', {
            method: 'POST',
            headers: { apikey: supabaseKey, 'Content-Type': 'application/json' },
            body: JSON.stringify({ p_slug: slug }),
            keepalive: true,
          }).catch(() => {});
        }
      } catch (e) {}
    </script>
  )}
</Base>

<style>
  .art-share { margin-top: 36px; }
  .art-share .section-title { margin-bottom: 14px; }
  .share-row { display: grid; gap: 8px; }
  .share-opt {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 16px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: transparent;
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .share-opt:hover { background: var(--paper-2); }
  @media (min-width: 640px) {
    .share-row { grid-template-columns: repeat(3, 1fr); }
    .share-opt { font-size: 15px; }
  }

  .suggestions { padding-top: 0; margin-top: 44px; display: flex; flex-direction: column; gap: 28px; font-size: 17px; }
  .suggestions .section-title { margin-bottom: 0; border-top-width: 2px; }
</style>

---
import Base from '../layouts/Base.astro';
import { getArticles } from '../lib/db';
import { formatDate } from '../lib/format';

const all = await getArticles();

// Aylara göre grupla: "Kasım 2026" → yazılar
const groups = new Map<string, typeof all>();
for (const a of all) {
  const key = new Date(a.published_at).toLocaleDateString('tr-TR', {
    month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul',
  });
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(a);
}
---
<Base title="Arşiv" description="Mürekkep Gazetesi'nde yayınlanan tüm yazılar.">
  <div class="wrap archive">
    <h1 class="page-title">Arşiv</h1>
    {all.length === 0 && <p class="meta">Henüz yazı yok.</p>}
    {[...groups].map(([month, items]) => (
      <section>
        <h2 class="section-title">{month}</h2>
        <ul>
          {items.map((a) => (
            <li>
              <time class="meta" datetime={a.published_at}>{formatDate(a.published_at)}</time>
              <a href={`/yazi/${a.slug}`} class="hl t">{a.title}</a>
              {a.label && <span class="label">{a.label}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .archive { max-width: 860px; padding-top: 36px; }
  .page-title { font-family: var(--font-head); font-size: 44px; margin: 0 0 28px; }
  section { margin-bottom: 36px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule-light);
  }
  .t { font-family: var(--font-head); font-weight: 600; font-size: 18px; line-height: 1.3; }
  @media (max-width: 600px) {
    li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

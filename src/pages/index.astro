---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { getFrontPage, getSettings } from '../lib/db';
import { feedItemHtml } from '../lib/render';

const { lead, latest, popular } = await getFrontPage();
const settings = await getSettings();

// Masaüstünde ilk birkaç yazı manşetin sağında; telefonda hepsi tek akış.
const SIDE_COUNT = 4;
const side = latest.slice(0, SIDE_COUNT);
const rest = latest.slice(SIDE_COUNT);
---
<Base>
  <div class="wrap home">
    {!lead && <p class="empty">Henüz yayımlanmış yazı yok.</p>}

    {lead && (
      <>
        <div class="home-top">
          <section class="home-lead" aria-label="Manşet">
            <div class="feed" set:html={feedItemHtml(lead, { lead: true })} />
          </section>

          {side.length > 0 && (
            <section class="home-latest" aria-label="Son yazılar">
              <div class="feed" set:html={side.map((a) => feedItemHtml(a)).join('')} />
            </section>
          )}
        </div>

        <div class="home-more">
          {rest.length > 0 && (
            <section class="home-feed" aria-label="Önceki yazılar">
              <h2 class="section-title desktop-only">Önceki Yazılar</h2>
              <div class="feed" set:html={rest.map((a) => feedItemHtml(a)).join('')} />
            </section>
          )}
          <Sidebar settings={settings} popular={popular} />
        </div>
      </>
    )}
  </div>

  <script is:inline>
    // Okur bir yazıdan geri döndüğünde akışta kaldığı yere dönsün
    // (tarayıcı geri önbelleği çalışmazsa yedek).
    (function () {
      var KEY = 'murekkep:akis-konum';
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        var y = Number(sessionStorage.getItem(KEY));
        if (nav && nav.type === 'back_forward' && y > 0) {
          addEventListener('load', function () { if (scrollY < 10) scrollTo(0, y); });
        }
        addEventListener('pagehide', function () { sessionStorage.setItem(KEY, String(scrollY)); });
      } catch (e) {}
    })();
  </script>
</Base>

<style>
  .home { padding-top: 20px; }
  .empty { text-align: center; padding: 80px 0; color: var(--ink-3); }

  /* Telefonda manşetten sonra akış başlıksız, aynı ince ayraçla kesintisiz sürer */
  .desktop-only { display: none; }
  .home-latest .feed > :global(.fi:first-child),
  .home-feed .feed > :global(.fi:first-child) { border-top: 1px solid var(--rule-light); }

  .home-more { display: grid; gap: 40px; }

  @media (min-width: 960px) {
    .home { padding-top: 24px; }
    .home-top {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: 0 28px;
      align-items: start;
    }
    .home-latest {
      padding-left: 28px;
      border-left: 1px solid var(--rule-light);
    }
    .home-latest .feed > :global(.fi:first-child) { border-top: 0; padding-top: 0; }

    /* Üst satırla aynı sütunlar: sağ sütun yukarıdan aşağı tek hizada */
    .home-more {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: 0 28px;
      margin-top: 36px;
    }
    .home-more > :global(aside.sidebar) { padding-left: 28px; }
    /* Az yazı varken (önceki yazılar yok) yan sütun yine sağda dursun */
    .home-more > :global(aside.sidebar:only-child) { grid-column: 2; }
    .desktop-only { display: block; }
    .home-feed .feed > :global(.fi:first-child) { border-top: 0; }
  }
</style>

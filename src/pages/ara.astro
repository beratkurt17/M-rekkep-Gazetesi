---
// Site içi arama sayfası. Davranış: src/scripts/arama.ts
import Base from '../layouts/Base.astro';
---
<Base title="Ara" description="Mürekkep'te yayımlanan yazılarda ara.">
  <div class="wrap arama">
    <h1 class="page-title">Ara</h1>
    <form id="arama-form" role="search" action="/ara/" method="get">
      <label for="arama-kutusu" class="visually-hidden">Yazılarda ara</label>
      <input id="arama-kutusu" name="q" type="search" placeholder="Başlık, yazar, dize…" autocomplete="off" enterkeyhint="search" />
      <button type="submit">Ara</button>
    </form>
    <p id="arama-durum" class="ar-durum" role="status" aria-live="polite"></p>
    <ol id="arama-sonuclari" class="ar-liste"></ol>
  </div>

  <script>
    import { initArama } from '../scripts/arama';
    initArama();
  </script>
</Base>

<style>
  .arama { max-width: 760px; padding-top: 32px; padding-bottom: 40px; }
  .page-title { font-family: var(--font-head); font-size: 44px; margin: 0 0 18px; }
  form { display: flex; gap: 8px; }
  input {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    padding: 0 16px;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    background: #f3ede2;
    font-family: var(--font-body);
    font-size: 18px; /* 16px altı iOS'ta yakınlaştırma yapar */
    color: var(--ink);
  }
  input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  button {
    min-height: 52px;
    padding: 0 20px;
    border: 0;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }
  .ar-durum { min-height: 1.5em; margin: 14px 0 6px; font-family: var(--font-ui); font-size: 14.5px; color: var(--ink-3); }
  .ar-liste { list-style: none; margin: 0; padding: 0; }
  .ar-liste :global(li) { padding: 18px 0; border-top: 1px solid var(--rule-light); }
  .ar-liste :global(h2) { margin: 0; font-family: var(--font-head); font-size: 21px; line-height: 1.25; }
  .ar-liste :global(a:hover h2) { text-decoration: underline; text-underline-offset: 3px; }
  .ar-liste :global(.ar-meta) { margin: 6px 0 0; font-family: var(--font-ui); font-size: 13px; color: var(--ink-3); }
  .ar-liste :global(.ar-excerpt) { margin: 8px 0 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .ar-liste :global(mark) { background: #e9cf9b; color: inherit; padding: 0 1px; border-radius: 2px; }
</style>

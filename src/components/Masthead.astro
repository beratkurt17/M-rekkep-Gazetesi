---
import { todayLong } from '../lib/format';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<header class:list={['masthead', { compact }]}>
  <div class="wrap">
    <div class="topline">
      <span class="meta">{todayLong()}</span>
      <span class="meta tagline">Edebiyat · Kültür · Sanat</span>
    </div>

    <a href="/" class="brand" aria-label="Mürekkep Gazetesi ana sayfa">
      <img src="/logo.jpg" alt="" width="56" height="56" class="logo" />
      <span class="wordmark">Mürekkep</span>
    </a>

    <nav class="nav" aria-label="Ana menü">
      <a href="/">Ana Sayfa</a>
      <a href="/arsiv">Arşiv</a>
      <a href="/kunye">Künye</a>
    </nav>
  </div>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .topline {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule-light);
  }
  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-block: 22px 14px;
  }
  .logo { border-radius: 50%; width: 56px; height: 56px; }
  .wordmark {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(40px, 8vw, 76px);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 4vw, 36px);
    padding-block: 10px;
    border-top: 3px double var(--rule);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .nav a:hover { color: var(--accent); }

  /* Yazı sayfalarında daha kısa başlık */
  .compact .topline { display: none; }
  .compact .brand { padding-block: 14px 10px; }
  .compact .logo { width: 40px; height: 40px; }
  .compact .wordmark { font-size: clamp(30px, 5vw, 44px); }

  @media (max-width: 560px) {
    .tagline { display: none; }
    .logo { width: 44px; height: 44px; }
  }
</style>

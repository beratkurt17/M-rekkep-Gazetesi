---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap inner">
    <a href="/" class="name">Mürekkep</a>
    <nav class="links" aria-label="Alt menü">
      <a href="/arsiv">Arşiv</a>
      <a href="/kunye">Künye</a>
    </nav>
    <p class="meta">© {year} Mürekkep Gazetesi. Tüm hakları saklıdır.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 64px;
    border-top: 3px double var(--rule);
    background: var(--paper-2);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 28px;
  }
  .name { font-family: var(--font-head); font-weight: 800; font-size: 26px; }
  .links {
    display: flex; gap: 20px;
    font-family: var(--font-ui); font-size: 13px; font-weight: 600;
  }
  .links a:hover { color: var(--accent); }
  .meta { margin: 0; width: 100%; }
</style>

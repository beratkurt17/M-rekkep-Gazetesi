---
// Yazı kartı. Her kartın görsel alanı vardır: kapak görseli ya da tipografik kapak.
//  - manset:    telefonda görsel üstte; masaüstünde görsel + başlık yan yana
//  - surmanset: telefonda sağda küçük kare; geniş ekranda görsel üstte
//  - list:      her zaman sağda küçük görsel
import type { Article } from '../lib/types';
import { formatDate } from '../lib/format';
import TypoCover from './TypoCover.astro';

interface Props {
  article: Article;
  variant?: 'manset' | 'surmanset' | 'list';
}
const { article: a, variant = 'list' } = Astro.props;
const href = `/yazi/${a.slug}`;
const HeadingTag = variant === 'manset' ? 'h2' : 'h3';
---
<article class:list={['card', variant]}>
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    {a.cover_image
      ? <img src={a.cover_image} alt="" loading={variant === 'manset' ? 'eager' : 'lazy'} decoding="async" />
      : <TypoCover article={a} variant={variant === 'manset' ? 'quote' : 'mark'} />}
  </a>
  <div class="text">
    {a.label && <span class="label">{a.label}</span>}
    <HeadingTag class="title"><a href={href} class="hl">{a.title}</a></HeadingTag>
    {a.byline && <span class="byline">{a.byline}</span>}
    {a.spot && <p class="spot">{a.spot}</p>}
    <time class="meta" datetime={a.published_at}>{formatDate(a.published_at)}</time>
  </div>
</article>

<style>
  .card { display: grid; gap: 14px; align-content: start; }
  .text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-2);
  }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media img, .media :global(.cover) { transition: transform 0.4s ease; }
  .card:hover .media img, .card:hover .media :global(.cover) { transform: scale(1.02); }

  .title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }
  .spot { margin: 2px 0 0; color: var(--ink-2); }

  /* ---------- Manşet ---------- */
  .manset .media { aspect-ratio: 4 / 3; }
  .manset .title { font-size: clamp(32px, 7vw, 46px); font-weight: 800; letter-spacing: -0.01em; }
  .manset .spot { font-size: clamp(17px, 2vw, 20px); line-height: 1.5; max-width: 62ch; }
  @media (min-width: 900px) {
    .manset {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 40px;
      align-items: center;
    }
    .manset .media { order: 2; aspect-ratio: 4 / 3; }
    .manset .title { font-size: clamp(40px, 4.4vw, 60px); }
  }

  /* ---------- Sürmanşet ---------- */
  .surmanset .title { font-size: 21px; }
  .surmanset .spot { font-size: 15px; }
  @media (max-width: 600px) {
    .surmanset { grid-template-columns: minmax(0, 1fr) 96px; align-items: start; }
    .surmanset .media { order: 2; aspect-ratio: 1; }
    .surmanset .title { font-size: 19px; }
    .surmanset .spot { display: none; }
  }

  /* ---------- Liste ---------- */
  .list {
    grid-template-columns: minmax(0, 1fr) 96px;
    align-items: start;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule-light);
  }
  .list .media { order: 2; aspect-ratio: 1; }
  .list .title { font-size: 19px; }
  .list .spot {
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .list { grid-template-columns: minmax(0, 1fr) 200px; gap: 24px; }
    .list .media { aspect-ratio: 16 / 9; }
    .list .title { font-size: 22px; }
  }
</style>

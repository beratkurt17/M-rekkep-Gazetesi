---
// Ana sayfa yan sütunu. Masaüstünde köşeler burada alt alta; telefonda köşeler
// sayfanın üstündeki tek kutuda (KoseKarti.astro) olduğu için burada yalnızca
// "Çok Okunanlar" görünür.
import type { Article, Koseler } from '../lib/types';
import { articlePath } from '../lib/render';
import EditorNotu from './koseler/EditorNotu.astro';
import GununDizesi from './koseler/GununDizesi.astro';
import GununKelimesi from './koseler/GununKelimesi.astro';
import BugunEdebiyatta from './koseler/BugunEdebiyatta.astro';

interface Props {
  koseler: Koseler;
  popular: Article[];
}
const { koseler: k, popular } = Astro.props;
---
<aside class="sidebar">
  {k.note && (
    <section class="kose">
      <h2 class="section-title">{k.note.title}</h2>
      <EditorNotu text={k.note.text} />
    </section>
  )}

  {k.quote && (
    <section class="kose">
      <h2 class="section-title">Günün Dizesi</h2>
      <GununDizesi quote={k.quote} />
    </section>
  )}

  {k.today.length > 0 && (
    <section class="kose">
      <h2 class="section-title">Bugün Edebiyatta · {k.todayLabel}</h2>
      <BugunEdebiyatta entries={k.today} />
    </section>
  )}

  {k.word && (
    <section class="kose">
      <h2 class="section-title">Günün Kelimesi</h2>
      <GununKelimesi word={k.word} />
    </section>
  )}

  {popular.length > 1 && (
    <section>
      <h2 class="section-title">Çok Okunanlar</h2>
      <ol class="popular">
        {popular.map((a) => <li><a href={articlePath(a.slug)}>{a.title}</a></li>)}
      </ol>
    </section>
  )}
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 36px; }
  .section-title { margin-bottom: 14px; }
  /* Telefonda köşeler üstteki kutuda */
  @media (max-width: 959px) { .kose { display: none; } }
  .popular { margin: 0; padding: 0; list-style: none; counter-reset: n; }
  .popular li {
    counter-increment: n;
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: baseline;
    padding-block: 11px;
    border-top: 1px solid var(--rule-light);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
  }
  .popular li:first-child { border-top: 0; padding-top: 0; }
  .popular li::before {
    content: counter(n);
    font-family: var(--font-brand);
    font-size: 22px;
    color: var(--accent);
  }
  .popular a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>

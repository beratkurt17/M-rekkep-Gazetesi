---
import type { Article, SiteSettings } from '../lib/types';
import { articlePath } from '../lib/render';

interface Props {
  settings: SiteSettings;
  popular: Article[];
}
const { settings, popular } = Astro.props;
const note = settings.editor_note;
const word = settings.daily_word;
---
<aside class="sidebar">
  {note?.text && (
    <section>
      <h2 class="section-title">{note.title || 'Editörden'}</h2>
      <p class="note">{note.text}</p>
    </section>
  )}

  {word?.word && (
    <section>
      <h2 class="section-title">Günün Kelimesi</h2>
      <p class="word">{word.word}</p>
      <p class="meaning">{word.meaning}</p>
    </section>
  )}

  {popular.length > 1 && (
    <section>
      <h2 class="section-title">Çok Okunanlar</h2>
      <ol class="popular">
        {popular.map((a) => <li><a href={articlePath(a.slug)}>{a.title}</a></li>)}
      </ol>
    </section>
  )}
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 36px; }
  .section-title { margin-bottom: 14px; }
  .note { margin: 0; font-style: italic; color: var(--ink-2); font-size: 17px; }
  .word { margin: 0; font-family: var(--font-brand); font-size: 36px; line-height: 1.1; }
  .meaning { margin: 6px 0 0; color: var(--ink-2); font-size: 16px; }
  .popular { margin: 0; padding: 0; list-style: none; counter-reset: n; }
  .popular li {
    counter-increment: n;
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: baseline;
    padding-block: 11px;
    border-top: 1px solid var(--rule-light);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
  }
  .popular li:first-child { border-top: 0; padding-top: 0; }
  .popular li::before {
    content: counter(n);
    font-family: var(--font-brand);
    font-size: 22px;
    color: var(--accent);
  }
  .popular a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>

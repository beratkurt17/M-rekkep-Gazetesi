---
// Ekran: site ayarları — davranışı src/admin/ekranlar/ayarlar.ts
---
<main id="view-settings" class="view" hidden>
  <div class="view-head"><h1>Ayarlar</h1></div>
  <form id="settings-form" class="settings">
    <section class="panel">
      <h2>Editörden notu</h2>
      <label>Başlık <input name="note_title" placeholder="Editörden" /></label>
      <label>Metin <textarea name="note_text" rows="4" placeholder="Boş bırakılırsa ana sayfada görünmez"></textarea></label>
    </section>
    <section class="panel">
      <h2>Günün kelimesi</h2>
      <label>Kelime <input name="word" /></label>
      <label>Anlamı <textarea name="meaning" rows="2"></textarea></label>
    </section>
    <button type="submit" class="btn primary">Kaydet</button>
  </form>
</main>

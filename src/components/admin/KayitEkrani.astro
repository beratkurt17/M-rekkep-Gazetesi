---
// Ortak kayıt ekranı iskeleti: liste + form. Davranışı src/admin/ortak/kayit-ekrani.ts
// Form alanları <slot /> ile ekrana özgü bileşenden gelir.
interface Props {
  view: string;     // gezinmedeki ekran adı → id="view-<view>"
  key: string;      // öğe id'lerinin ön eki
  title: string;    // "Yazarlar"
  newLabel: string; // "+ Yeni yazar"
}
const { view, key, title, newLabel } = Astro.props;
---
<main id={`view-${view}`} class="view kayit-ekrani" hidden>
  <div id={`${key}-liste`}>
    <div class="view-head">
      <h1>{title}</h1>
      <button type="button" id={`${key}-yeni`} class="btn primary big">{newLabel}</button>
    </div>
    <slot name="aciklama" />
    <ul id={`${key}-listesi`} class="post-list"></ul>
    <p id={`${key}-bos`} class="muted" hidden></p>
  </div>

  <div id={`${key}-duzen`} hidden>
    <div class="view-head">
      <button type="button" id={`${key}-geri`} class="btn ghost">← {title}</button>
    </div>
    <form id={`${key}-form`} class="settings" novalidate>
      <h2 id={`${key}-baslik`} class="kayit-baslik"></h2>
      <slot />
      <div class="kayit-islemler">
        <button type="button" id={`${key}-sil`} class="btn ghost small danger" hidden>Sil</button>
        <span class="spacer"></span>
        <button type="submit" class="btn primary big">Kaydet</button>
      </div>
      <p id={`${key}-durum`} class="save-state" role="status" aria-live="polite"></p>
    </form>
  </div>
</main>

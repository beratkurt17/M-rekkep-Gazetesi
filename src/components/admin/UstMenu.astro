---
// Panel: üst menü (sekmeler ve genel düğmeler)
---
<header class="topbar">
  <a href="/" target="_blank" class="brand">Mürekkep <span>Yönetim</span></a>
  <!-- Telefonda alt çubuk olur (src/styles/admin.css → .tabs) -->
  <nav class="tabs" aria-label="Panel bölümleri">
    <button data-view="list" class="tab active">Yazılar</button>
    <button data-view="issues" class="tab">Sayılar</button>
    <button data-view="authors" class="tab">Yazarlar</button>
    <button data-view="series" class="tab">Diziler</button>
    <button data-view="corners" class="tab">Köşeler</button>
  </nav>
  <div class="top-actions">
    <button id="rebuild-btn" class="btn ghost small" title="Siteyi şimdi yeniden oluştur">Siteyi güncelle</button>
    <button id="logout-btn" class="btn ghost small">Çıkış</button>
  </div>
</header>

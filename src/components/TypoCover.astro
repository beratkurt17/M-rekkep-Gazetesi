---
// Görseli olmayan yazının yerine geçen tipografik kapak.
//  - "quote": manşet için; yazıdan bir alıntı (merak uyandırır)
//  - "mark":  diğer kartlar için; büyük baş harf
// Boyutu kapsayıcıya göre ölçeklenir (container query), küçük küçük resimde sadece harf kalır.
import type { Article } from '../lib/types';
import { coverTone, initialOf } from '../lib/cover';
import { pullQuote } from '../lib/format';

interface Props {
  article: Article;
  variant?: 'quote' | 'mark';
}
const { article: a, variant = 'mark' } = Astro.props;
const quote = variant === 'quote' ? pullQuote(a.body) : null;
---
<div class:list={['cover', quote ? 'quote' : 'mark']} style={`--tone: ${coverTone(a)}`} aria-hidden="true">
  <div class="frame">
    {a.label && <span class="c-label">{a.label}</span>}
    {quote
      ? <p class="c-quote">{quote}</p>
      : <span class="c-initial">{initialOf(a.title)}</span>}
    {quote && <span class="c-mark">Mürekkep</span>}
  </div>
</div>

<style>
  .cover {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    padding: clamp(5px, 3.5cqi, 14px);
    color: #f3ead6;
    background:
      radial-gradient(120% 90% at 20% 10%, rgba(255, 255, 255, 0.08), transparent 60%),
      var(--grain),
      var(--tone);
  }

  /* İnce çift çerçeve: eski baskı sayfası süsü */
  .frame {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3cqi;
    padding: 6cqi;
    border: 1px solid rgba(243, 234, 214, 0.35);
    outline: 1px solid rgba(243, 234, 214, 0.18);
    outline-offset: 3px;
    text-align: center;
  }

  .c-label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(9px, 3.6cqi, 13px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .c-initial {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 42cqi;
    line-height: 0.9;
  }

  .c-quote {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-head);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(17px, 5.4cqi, 30px);
    line-height: 1.3;
    text-wrap: balance;
  }
  .c-quote::before {
    content: '“';
    display: block;
    font-size: 2.4em;
    line-height: 0.6;
    margin-bottom: 0.1em;
    opacity: 0.6;
  }

  .c-mark {
    margin-top: 2cqi;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(9px, 3.2cqi, 13px);
    letter-spacing: 0.04em;
    opacity: 0.55;
  }

  /* Küçük resim boyutunda (ör. 104px) sadece baş harf kalsın */
  @container (max-width: 180px) {
    .c-label { display: none; }
    .frame { padding: 0; outline: none; }
    .c-initial { font-size: 56cqi; }
  }
</style>
